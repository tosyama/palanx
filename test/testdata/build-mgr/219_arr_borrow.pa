cinclude <stdio.h>;
cinclude <string.h>;

const H = 3;
const W = 4;

[H][W]int32 grid;
int32 i = 0;
while i < H {
	int32 j = 0;
	while j < W { i * 10 + j -> grid[i][j]; j + 1 -> j; }
	i + 1 -> i;
}
printf("%d\n", sum2d(@grid));
fill2d(@!grid, 7);
printf("%d %d\n", grid[0][0], grid[2][3]);

[4]int64 v;
memset(@!v, 0, 32);
set1d(@!v);
printf("%ld %ld\n", v[0], v[3]);
@[4]int64 rv = @v;
printf("%ld\n", rv[2]);

[2]$[3]int16 m;
setm(@!m);
printf("%d %d\n", m[0][0], m[1][2]);

func sum2d(@[H][W]int32 g) -> int32 {
	int32 s = 0;
	int32 i = 0;
	while i < H {
		int32 j = 0;
		while j < W { s + g[i][j] -> s; j + 1 -> j; }
		i + 1 -> i;
	}
	return s + corner(@g);
}

func corner(@[3][4]int32 g) -> int32 {
	return g[2][3];
}

func fill2d(@![H][W]int32 g, int32 x) {
	x -> g[0][0];
	x + 1 -> g[2][3];
}

func set1d(@![4]int64 a) {
	5 -> a[0];
	6 -> a[3];
	8 -> a[2];
}

func setm(@![2]$[3]int16 a) {
	1 -> a[0][0];
	9 -> a[1][2];
}
