cinclude <stdio.h>;

func show(@[3]int32 src)
{
	[3]int32 d = src;
	0 -> d[0];
	printf(" %d %d\n", d[0] + d[1] + d[2], src[0]);
}

[3]int32 a = [1, 2, 3];
[3]int32 b;
a -> b;
0 -> a[0];
[3]int32 c = b;
9 -> b[2];
printf("%d %d %d", b[0], c[0], c[2]);
show(@b);

[2][3]int32 m = [[1, 2, 3], [4, 5, 6]];
[2][3]int32 k = m;
7 -> m[1][2];
m[1] -> k[0];
0 -> m[1][0];
printf("%d %d %d\n", k[0][0], k[0][2], k[1][2]);

[2]$[3]int32 e;
[2]$[3]int32 f;
3 -> e[1][2];
e -> f;
0 -> e[1][2];
printf("%d\n", f[1][2]);
