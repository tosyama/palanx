cinclude <dirent.h>;
cinclude <stdio.h>;

// Field access on an incomplete struct through a real dirent.h handle -- the
// same rule sa-tester pins on a synthetic struct
// (error_127_incomplete_struct_field_access), exercised here via the `DIR`
// typedef alias and a real cinclude'd system header.
@!DIR d = opendir(".");
printf("%d\n", d.fd);
