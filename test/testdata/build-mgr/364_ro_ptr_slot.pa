cinclude <stdio.h>;
type P { int32 x; int32 y; };
func sum(@[2]@[]int32 x) -> int32 { return x[0][2] + x[1][1]; }
[3]int32 a = [1,2,3];
[2]int32 b = [7,8];
[2]@[]int32 s;
@a -> s[0];
@b -> s[1];
[2]$[2]int32 m = [[1,2],[3,4]];
[1]@[]$[2]int32 r;
@m -> r[0];
[2]$P ps;
5 -> ps[1].y;
[1]@[]$P q;
@ps -> q[0];
printf("%d %d %d %d\n", s[1][0], sum(@s), r[0][1][0], q[0][1].y);
