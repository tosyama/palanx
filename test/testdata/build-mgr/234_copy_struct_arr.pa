cinclude <stdio.h>;
type Point { int32 x; int32 y; };
type Seg { Point a; Point b; };

[2]Point sa = [[1, 2], [3, 4]];
[2]Point sb = sa;
0 -> sa[1].x;
sa[0] -> sb[0];
printf("%d %d %d\n", sb[1].x, sb[0].y, sa[1].x);

[2][4]$Point minos = [
	[0,0][0,1][0,2][0,3],
	[0,0][0,1][1,1][2,1],
];
[4]$Point mino;
minos[1] -> mino;
minos[0][3] -> mino[0];
0 -> minos[1][3].x;
printf("%d %d %d\n", mino[3].x, mino[0].y, mino[1].y);

[2][4]$Point minos2 = minos;
9 -> minos[0][2].y;
printf("%d %d\n", minos2[0][2].y, minos2[1][2].x);

[2][2]Seg ss;
5 -> ss[1][0].b.y;
[2][2]Seg st = ss;
0 -> ss[1][0].b.y;
ss[0][1] -> st[1][1];
printf("%d %d\n", st[1][0].b.y, st[1][1].b.y);
