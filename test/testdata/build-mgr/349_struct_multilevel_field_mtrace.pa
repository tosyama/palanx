cinclude <stdio.h>;
cinclude <mcheck.h>;
type P { int32 x; int64 y; };
type S { int32 k; [3][4]int32 m; [2][3]$P q; [2][+]int32 v; };
type L { int32 k; [2][2]int32 g; };
func get(@[3][4]int32 a) -> int32 r { a[2][3] -> r; }
mtrace();
{
	S s;
	5 -> s.m[2][3];
	6 -> s.q[1][2].y;
	7 -> s.v[1].push();
	8 -> s.v[1].push();
	S t = s;
	9 -> t.m[2][3];
	10 -> t.v[1].push();
	int64 sl = len(@s.v[1]); int64 tl = len(@t.v[1]);
	printf("%d %d %d %d %d %d %d\n", s.m[2][3], t.m[2][3], t.q[1][2].y, t.v[1][1], sl, tl, get(@s.m));
	$S fs;
	1 -> fs.m[0][0];
	2 -> fs.v[0].push();
	printf("%d %d\n", fs.m[0][0], fs.v[0][0]);
	[2]S a;
	3 -> a[1].m[1][1];
	4 -> a[1].v[0].push();
	printf("%d %d\n", a[1].m[1][1], a[1].v[0][0]);
	[3][4]int32 n;
	11 -> n[2][3];
	n ->> s.m;
	printf("%d\n", s.m[2][3]);
	L l = {k: 1, g: [[1, 2], [3, 4]]};
	printf("%d %d\n", l.g[1][0], l.k);
}
muntrace();
