cinclude <stdio.h>;
type Point { int64 x; int64 y; };

func makeArr() -> [+]int64 r
{
	[1, 2, 3] -> r;
}

func sumRo(@[+]int64 v) -> int64 s
{
	0 -> s;
	for a in v { s + a -> s; }
}

[+]int64 v = [10, 20, 30, 40];
int64 s = 0;
for a, i in v {
	if i == 1 { continue; }
	if i == 3 { break; }
	s + a -> s;
}
printf("%ld\n", s);

for @!a in v { a[0] + 1 -> a[0]; }
printf("%ld %ld\n", v[0], sumRo(@v));

[3]int64 c = [1, 2, 3];
for @a, i in c { printf("%ld:%ld ", i, a[0]); }
printf("\n");

[2]$[3]int64 rows = [[1, 2, 3], [4, 5, 6]];
for @r in rows {
	for x in r { printf("%ld ", x); }
}
printf("\n");

for x, i in makeArr() { printf("%ld=%ld ", i, x); }
printf("\n");

[+]Point ps = [{x: 1, y: 2}, {x: 3, y: 4}];
for p in ps { printf("(%ld,%ld)", p.x, p.y); }
for @!p in ps { 0 -> p.x; }
for @p in ps { printf("(%ld,%ld)", p.x, p.y); }
printf("\n");

for a, i in args { printf("%ld %s\n", i, a); }
