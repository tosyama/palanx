cinclude <sys/stat.h>;
cinclude <stdio.h>;

// IT-2026-09-06-2911: umask(0) makes the mkdir permission bits below
// deterministic regardless of the environment's inherited umask -- without
// this, st_mode & ACCESSPERMS after mkdir would vary by caller and the
// expected output couldn't be pinned. Also exercises IT-2910's constant
// folding on the sys/stat.h expression macros (S_IRWXU, ACCESSPERMS, ...).
uint32 inherited = umask(0);

mkdir("/tmp/pln_157_dir", S_IRWXU | S_IRWXG);
stat d;
stat("/tmp/pln_157_dir", d);
printf("mkdir_perm=%u\n", d.st_mode & ACCESSPERMS);

chmod("/tmp/pln_157_dir", S_IRUSR | S_IWUSR | S_IXUSR | S_IRGRP | S_IXGRP);
stat("/tmp/pln_157_dir", d);
printf("chmod_perm=%u\n", d.st_mode & ACCESSPERMS);

uint32 prev = umask(63);
printf("umask_roundtrip=%u\n", prev);
umask(inherited);

printf("consts=%u %u %u %u %u\n", S_IRWXU, S_IRWXG, S_IRWXO, ACCESSPERMS, ALLPERMS);
