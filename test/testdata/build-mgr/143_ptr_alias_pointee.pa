cinclude <stdio.h>;

// A type alias or C typedef used as a pointee used to reach
// PlnTypeRegistry::fromJson unresolved and abort with "unknown prim
// type-name: ...". Both previously aborted (rc=134):
type MyInt = int64;
int64 a = 42;
@MyInt p = @a;

uint64 n = 7;
@!size_t q = @!n;

printf("%ld %lu\n", p[0], q[0]);
