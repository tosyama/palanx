cinclude <stdio.h>;

// Regression for IT-2026-09-06-2902: deepNormalizePrimToStruct only resolved
// prim(Name) -> struct(Name) via structDefs_, without re-applying
// resolveTypeAlias at each level of a pntr chain, so a type alias or C
// typedef used as a pointee reached PlnTypeRegistry::fromJson unresolved and
// aborted with "unknown prim type-name: ...". Both previously aborted (rc=134):
type MyInt = int64;
int64 a = 42;
@MyInt p = @a;

uint64 n = 7;
@!size_t q = @!n;

printf("%ld %lu\n", p[0], q[0]);
