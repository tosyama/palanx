cinclude <stdio.h>;

[]int32 a = [1, 2, 3];
const N = len(@a);
[N * 2]int32 b;
int32 i = 0;
while i < len(@b) {
	a[i % N] * 10 -> b[i];
	i + 1 -> i;
}
0 -> i;
while i < len(@b) {
	printf("%d ", b[i]);
	i + 1 -> i;
}
printf("\n");

[+]int32 v;
v.push(5);
v.push(6);
0 -> i;
while i < len(@v) {
	printf("%d ", v[i]);
	i + 1 -> i;
}
printf("%ld\n", v -> len());
