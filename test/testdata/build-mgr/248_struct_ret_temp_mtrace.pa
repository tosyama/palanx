cinclude <stdio.h>;
cinclude <string.h>;
cinclude <mcheck.h>;
type P { int32 x; };
type Q { [2]int32 a; };
func g() -> P p { P p; 3 -> p.x; }
func h() -> Q q { Q q; 5 -> q.a[1]; }
func k(@P q) -> int32 r { q.x -> r; }
func kp(P q) -> int32 r { q.x + 1 -> r; }
func kq(@Q q) -> int32 r { q.a[1] -> r; }
func g2(@P q) -> P p { P p; q.x * 2 -> p.x; }
func two(@P q) -> int32 a, int32 b { q.x -> a; q.x + 10 -> b; }
mtrace();
{
    printf("%d %d %d %d\n", k(g()), kp(g()), kq(h()), k(g2(g())));
    bool f = false;
    if f && k(g()) > 0 { printf("no\n"); }
    if !f && k(g()) > 0 { printf("yes\n"); }
    int32 i = 0;
    while k(g()) + i < 6 { i + 1 -> i; }
    (int32 a, int32 b) = two(g());
    memset(g(), 0, 4);
    g(); h();
    printf("%d %d %d\n", i, a, b);
}
muntrace();
