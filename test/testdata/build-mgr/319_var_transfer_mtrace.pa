cinclude <stdio.h>;
cinclude <mcheck.h>;
type P { int32 x; [2]int32 a; };
type Q { int32 x; };
func mk(int32 x) -> P p { x -> p.x; x + 1 -> p.a[1]; }
type W { P p; };
mtrace();
{
    [4]int32 a = [1, 2, 3, 4];
    [4]int32 c;
    a ->> c;
    printf("%d\n", c[3]);
    Q q1 = {x: 5};
    Q q2;
    q1 ->> q2;
    printf("%d\n", q2.x);
    P p1 = mk(3);
    P p2;
    p1 ->> p2;
    printf("%d %d\n", p2.x, p2.a[1]);
    mk(7) ->> p2;
    printf("%d\n", p2.x);
    [3]P ps;
    [3]P qs;
    9 -> ps[1].x;
    ps ->> qs;
    printf("%d\n", qs[1].x);
    W w;
    p2 ->> w.p;
    w.p ->> p1;
    printf("%d\n", p1.x);
    qs[2] ->> p2;
    printf("%d\n", p2.x);
    [2][4]int32 g;
    [4]int32 r = [5, 6, 7, 8];
    r ->> c ->> g[1];
    printf("%d\n", g[1][0]);
    {
        [4]int32 t = [9, 9, 9, 9];
        t ->> c;
    }
    printf("%d\n", c[0]);
}
muntrace();
