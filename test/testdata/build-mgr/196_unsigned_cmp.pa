cinclude <stdio.h>;

uint8 a8 = 250;
uint8 b8 = 10;
uint16 a16 = 65000;
uint16 b16 = 10;
uint32 a32 = 4000000000;
uint32 b32 = 10;
uint64 a64 = 18446744073709551600;
uint64 b64 = 10;
int32 s1 = -6;
int32 s2 = 10;

printf("%d%d%d", a8 < b8, a8 <= b8, a8 > b8);
printf("%d%d%d\n", a8 >= b8, a8 == b8, a8 != b8);
printf("%d%d%d", a16 < b16, a16 <= b16, a16 > b16);
printf("%d%d%d\n", a16 >= b16, a16 == b16, a16 != b16);
printf("%d%d%d", a32 < b32, a32 <= b32, a32 > b32);
printf("%d%d%d\n", a32 >= b32, a32 == b32, a32 != b32);
printf("%d%d%d", a64 < b64, a64 <= b64, a64 > b64);
printf("%d%d%d\n", a64 >= b64, a64 == b64, a64 != b64);
printf("%d%d%d", s1 < s2, s1 <= s2, s1 > s2);
printf("%d%d%d\n", s1 >= s2, s1 == s2, s1 != s2);

if a32 > b32 { printf("if ok\n"); }

uint8 i = 250;
int32 n = 0;
while i >= 250 {
    i + 1 -> i;
    n + 1 -> n;
}
printf("%d\n", n);
