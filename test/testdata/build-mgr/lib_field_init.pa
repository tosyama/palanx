const N = 4;
export type Color enum { Red, Green, Blue };
export type P { int32 x = N * 2 - 1; uint8 u = 200; bool b = true; flo64 f = 2; Color c = Color.Blue; };
export type Str { $[+]uint8 bytes = [104, 105, 0]; bool valid = true; };
export type A { [3]int16 r = [1, -2, 3]; $[2]int64 e = [5, 6]; [+]int32 v = [7, 8]; };
export type Q { int8 k; $P p; $Str s; P o; [2]P ps; $[2]$P es; [+]$P vs; };
