cinclude <stdio.h>;
cinclude <mcheck.h>;
import "lib_field_init.pa";

func show(@P p) { printf("%d %d %d %.1f %d\n", p.x, p.u, p.b, p.f, p.c); }

func run() {
	P p;
	show(@p);
	$P fp;
	show(@fp);
	Str s;
	printf("%s %ld %d\n", s.bytes, len(@s.bytes), s.valid);
	A a;
	printf("%d %d %d %ld %ld %ld %d\n", a.r[0], a.r[1], a.r[2], a.e[0], a.e[1], len(@a.v), a.v[1]);

	Q q;
	show(@q.p); show(@q.o); show(@q.ps[1]); show(@q.es[1]);
	printf("%s %ld\n", q.s.bytes, len(@q.vs));
	q.vs.resize(2);
	show(@q.vs[1]);
	Q q2 = q;
	show(@q2.es[0]);

	[3]$P ap;
	[2]$[2]$P mp;
	[2][3]$P rows;
	[2]P sp;
	show(@ap[2]); show(@mp[1][1]); show(@rows[1][2]); show(@sp[1]);
	[+]P w;
	w.push({x: 8});
	w.resize(2);
	[+]$P lit = [{u: 1}, [3, 4, false, 0.5, Color.Green]];
	show(@w[0]); show(@w[1]); show(@lit[0]); show(@lit[1]);

	P named = {x: 9};
	show(@named);
	{x: 3, c: Color.Red} -> named;
	show(@named);
}
mtrace();
run();
muntrace();
