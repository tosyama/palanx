cinclude <stdio.h>;

// Parameter n is used only as a call argument inside the while loop (not as Cmp operand).
// Its live range extends to the loop's backward jump, so it crosses printf.
func print_n_times(int64 n) {
    int64 i = 0;
    while i < 3 {
        printf("%ld\n", n);
        i + 1 -> i;
    }
}

print_n_times(42);
