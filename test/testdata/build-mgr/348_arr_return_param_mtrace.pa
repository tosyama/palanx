cinclude <stdio.h>;
cinclude <mcheck.h>;

type P { int32 x; [2]int32 a; };
type Q { int32 x; int32 y; };

func show(@[3]int32 v) { printf("%d %d %d\n", v[0], v[1], v[2]); }

func mk(int32 b) -> [3]int32 r {
	b -> r[0]; b + 1 -> r[1]; b + 2 -> r[2];
}
func inc([3]int32 x) -> [3]int32 {
	x[0] + 100 -> x[0];
	return x;
}
func dup(@[3]int32 p) -> [3]int32 { return p; }
func lit(int32 n) -> [3]int32 { return [n, n, n]; }
func framed() -> [3]int32 { $[3]int32 f = [4, 5, 6]; return f; }
func row(@[2][3]int32 g) -> [3]int32 { return g[1]; }
func grid() -> [2][3]int32 { return [[1, 2, 3], [4, 5, 6]]; }
func ps(int32 n) -> [2]P { [2]P q; n -> q[1].x; n -> q[1].a[1]; return q; }
func field(@[2]P q) -> [2]int32 { return q[1].a; }
func vs([2][+]int32 v) -> int64 { v[1].push(5); return len(@v[1]); }
func two() -> [3]int32 a, int32 n { mk(7) -> a; 9 -> n; }
func em() -> [2]$Q { [2]$Q e; 3 -> e[0].x; return e; }

func t()
{
	[3]int32 a = mk(1);
	[3]int32 b = inc(a);
	show(@a); show(@b);
	inc(mk(10)) -> b; show(@b);
	show(@dup(@a));
	[3]int32 c = lit(8); show(@c);
	framed() -> c; show(@c);
	[2][3]int32 g = grid();
	row(@g) -> c; show(@c);
	[2]P q = ps(4);
	ps(6) ->> q;
	[2]int32 f = field(@q);
	printf("%d %d %d\n", q[1].x, q[1].a[1], f[1]);
	[2][+]int32 v;
	printf("%lld %lld\n", vs(v), len(@v[1]));
	([3]int32 d, int32 n) = two();
	show(@d); printf("%d\n", n);
	c -> inc() -> d; show(@d);
	show(@inc([1, 2, 3]));
	inc(a);
	[2]$Q e = em(); printf("%d\n", e[0].x);
	$[3]int32 fr = mk(20); show(@fr);
}

mtrace();
t();
