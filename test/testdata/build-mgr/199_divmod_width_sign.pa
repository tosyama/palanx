cinclude <stdio.h>;

int8 a8 = -7;
int8 b8 = 2;
int8 m8 = -128;
int8 n8 = -1;
int16 a16 = -30000;
int16 b16 = 7;
int32 a32 = -2000000000;
int32 b32 = 3;
int64 a64 = -9000000000000000000;
int64 b64 = 7;
uint8 u8 = 250;
uint8 v8 = 7;
uint16 u16 = 65000;
uint16 v16 = 7;
uint32 u32 = 4000000000;
uint32 v32 = 7;
uint64 u64 = 18446744073709551600;
uint64 v64 = 10;

printf("%d %d %d %d\n", a8 / b8, a8 % b8, m8 / n8, m8 % n8);
printf("%d %d\n", a16 / b16, a16 % b16);
printf("%d %d\n", a32 / b32, a32 % b32);
printf("%ld %ld\n", a64 / b64, a64 % b64);
printf("%u %u %u %u\n", u8 / v8, u8 % v8, u16 / v16, u16 % v16);
printf("%u %u\n", u32 / v32, u32 % v32);
printf("%lu %lu\n", u64 / v64, u64 % v64);

int8 r8 = 0;
uint32 r32 = 0;
m8 / n8 -> r8;
u32 / (v32 + 1) -> r32;
printf("%d %u\n", r8, r32);
