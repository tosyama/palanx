cinclude <stdio.h>;

func twice(int32 a) -> int32 {
	return a * 2;
}

func sumAfterPrint(int32 a, int32 b) -> int32 {
	int32 s = a + b;
	printf("a=%d\n", a);
	return s;
}

func sumAfterCall(int32 a, int32 b) -> int32 {
	int32 s = a + b;
	int32 t = twice(a);
	printf("t=%d\n", t);
	return s;
}

printf("%d %d\n", sumAfterPrint(7, 2), sumAfterCall(3, 4));

// The divisor arrives in %rdx as the third parameter.
func divThird(int64 a, int64 b, int64 c) -> int64 {
	return a / c + b;
}
printf("%ld\n", divThird(20, 1, 4));
