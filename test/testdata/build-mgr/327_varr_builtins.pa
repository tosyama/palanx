cinclude <stdio.h>;

// Past the minimum capacity 4 and its doubling to 8.
[+]int32 v;
int32 i = 0;
while i < 10 {
	push(@!v, i);
	i + 1 -> i;
}
v.push(100);
200 -> v.push();
printf("%ld %ld\n", len(@v), v -> len());
int32 x = v.pop();
printf("%d %ld\n", x, len(@v));

// Growing back after shrinking brings back zeros, not the old elements.
v.resize(3);
v.resize(5);
0 -> i;
while i < len(@v) {
	printf("%d ", v[i]);
	i + 1 -> i;
}
printf("\n");

[+]flo64 f;
f.push(1.5);
f.push(2.5);
flo64 y = f.pop();
printf("%.1f %.1f %ld\n", y, f[0], len(@f));

[+2]int8 c;
c.resize(20);
19 -> c[19];
c.push(int8(7));
printf("%d %d %ld\n", c.pop(), c[19], len(@c));
