cinclude <stdio.h>;
cinclude <mcheck.h>;
import "lib_vec_ops.pa";

func show(@vec3 v) { printf("%g %g %g\n", v.x, v.y, v.z); }

mtrace();
{
	vec3 a = [1.0, 2.0, 3.0];
	$vec3 b = [0.5, 0.5, 0.5];
	vec3 c = a + b;
	show(@c);
	a - b -> show();
	-a -> show();
	-(a + b) -> show();
	2 * a - a * 0.5 -> show();
	a + b + c - a * 3.0 -> show();
	printf("%g\n", a * b);
	c + a -> c;
	show(@c);
}
muntrace();
