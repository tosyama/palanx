cinclude <stdio.h>;
cinclude <mcheck.h>;
type P { int32 x; [+]int32 tags; };
func mk(int32 x) -> P p { x -> p.x; p.tags.push(x); }
func total([...]P ps) -> int32 t {
	for @p in ps { t + p.x -> t; }
}
func keep([...]P ps) -> P {
	P kept;
	ps[1] ->> kept;
	99 -> ps[0].x;
	return kept;
}
func bsum([...]@P ps) -> int32 t {
	for @p in ps { t + p.x -> t; }
}
func scale(int32 k, [...]int32 xs) -> int32 t {
	for @!x in xs { x * k -> x; }
	for copy x in xs { t + x -> t; }
}
mtrace();
{
	P a = mk(1);
	P b = mk(2);
	printf("%d\n", total(a, b, mk(3), [4, []]));
	P k = keep(a, mk(5), b);
	printf("%d %d %d\n", k.x, a.x, b.x);
	printf("%d\n", bsum(@a, @b, @k));
	printf("%d\n", scale(2, 1, 2, 3));
}
