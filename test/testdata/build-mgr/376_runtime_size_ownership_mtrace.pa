cinclude <stdio.h>;
cinclude <mcheck.h>;
type S { int32 x; [+]int32 v; };
func sum4([4]int32 a) -> int32 r
{
	a[0] + a[1] + a[2] + a[3] -> r;
}
func show(@S s)
{
	printf("%d:%d ", s.x, int32(len(@s.v)));
}
mtrace();
{
	int64 n = 4;
	int64 m = 3;
	[n]int32 a;
	[n]int32 b;
	int64 i = 0;
	while i < n { int32(i + 1) -> a[i]; i + 1 -> i; }
	a ->> b;
	[n]int32 c <<= b;
	[n]int32 d;
	c -> d;
	printf("%d %d %d %d\n", b == NULL, c[3], d[2], sum4(c>>));

	[n]S s;
	0 -> i;
	while i < n { int32(i) -> s[i].x; s[i].v.push(int32(i)); i + 1 -> i; }
	[n]S t <<= s;
	[n]S u;
	t -> u;
	show(@u[3]);
	show(@t[1]);
	printf("\n");

	[n][m]int32 g;
	[n][m]int32 h;
	7 -> g[3][2];
	g -> h;
	[m]int32 row;
	9 -> row[0];
	row ->> h[1];
	printf("%d %d\n", h[3][2], h[1][0]);

	[n]$[m]int32 e;
	[n]$[m]int32 f;
	5 -> e[2][1];
	e -> f;
	[m]int32 r2;
	f[2] -> r2;
	printf("%d %d\n", f[2][1], r2[1]);
}
muntrace();
