cinclude <stdio.h>;
cinclude <string.h>;

func dump(@[]uint8 s, int32 n) {
	int32 i = 0;
	while i < n { printf("%02x ", s[i]); i + 1 -> i; }
	printf("%ld\n", strlen(s));
}

// An invalid UTF-8 byte, written as an escape or as the byte itself.
dump("x\xFFy\x00z", 5);
dump("\\\"\t\r\x01\xe2\x82\xACÿ\xC3\xA9", 11);
