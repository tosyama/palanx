cinclude <stdio.h>;
cinclude <unistd.h>;
type Pt { int32 x; int32 y; };
global int32 hits = 0 for count!, report;
global []int32 arr = [1, 2] for report;
global $Pt origin = [3, 4] for move!;
global optind for count!;
count();
func count() { hits + 1 -> hits; 1 -> optind; }
func move() { origin.x + 1 -> origin.x; }
func report() { printf("%d %d\n", hits, arr[0]); }
