func g(int32 a) -> int32 { return a; }
func g(flo32 a) -> flo32 { return a; }
func abs(flo64 x) -> flo64 { return x; }
func len(@Vec v) -> int64 { return v.x; }
func len(@Counter c) -> int64 { return c.n; }
func add(@!Counter c, int32 d) { c.n + d -> c.n; }
func add(Counter c, int64 d) { }
func h(int32 x) -> int32 { return x; }
func h(flo64 x) -> flo64 { return x; }
